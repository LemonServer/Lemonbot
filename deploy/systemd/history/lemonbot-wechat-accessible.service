[Unit]
Description=Official WeChat with accessibility enabled for Lemonbot observe probe
Documentation=file:///home/lemon/Lemonbot/docs/operations.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
Environment=QT_LINUX_ACCESSIBILITY_ALWAYS_ON=1
ExecStart=/usr/bin/wechat
Restart=no
KillMode=mixed
TimeoutStopSec=15
UMask=0077
NoNewPrivileges=yes
LockPersonality=yes
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=graphical-session.target
